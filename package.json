{
  "name": "retournement-de-situation",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/local.js",
    "build": "vite build --mode solo",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:browser": "npm run build:coop && node tests/browser.mjs",
    "cf:dev": "npm run build:coop && wrangler dev --config wrangler.coop.jsonc",
    "deploy": "npm run build && wrangler deploy",
    "test:cloudflare": "node tests/cloudflare.mjs",
    "format": "prettier --write src shared server tests vite.config.js",
    "start": "node server/local.js --production",
    "deploy:solo": "npm run deploy",
    "test:solo": "npm run build:solo && node tests/solo-browser.mjs",
    "build:solo": "npm run build",
    "build:coop": "vite build --mode production",
    "cf:solo": "npm run build && wrangler dev",
    "deploy:coop": "npm run build:coop && wrangler deploy --config wrangler.coop.jsonc",
    "test:party": "node tests/party-browser.mjs",
    "test:observer": "npm run build && node tests/observer-browser.mjs",
    "plans": "node scripts/generate-plans.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.2.6",
    "@fontsource/dm-sans": "5.2.8",
    "three": "0.180.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "vite": "7.1.12",
    "wrangler": "4.45.0"
  }
}
