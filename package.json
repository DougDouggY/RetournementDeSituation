{
  "name": "retournement-de-situation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/local.js",
    "build": "vite build",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:browser": "npm run build && node tests/browser.mjs",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:cloudflare": "node tests/cloudflare.mjs",
    "format": "prettier --write src shared server tests vite.config.js",
    "start": "node server/local.js --production",
    "deploy:solo": "npm run build:solo && wrangler deploy --config wrangler.solo.jsonc",
    "test:solo": "npm run build:solo && node tests/solo-browser.mjs",
    "build:solo": "vite build --mode solo"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.2.6",
    "@fontsource/dm-sans": "5.2.8",
    "three": "0.180.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "vite": "7.1.12",
    "wrangler": "4.45.0"
  }
}
